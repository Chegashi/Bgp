#!/bin/sh

# Router 3 - Leaf 2 / VTEP
# Loopback: 1.1.1.3/32
# eth1: 10.1.1.6/30 (to Spine / _mchegri-1 eth1)
# eth0: connected to host-mchegri-2

# Clean up any existing vxlan/bridge if re-running
ip link del dev vxlan10 2>/dev/null || true
ip link del dev br0 2>/dev/null || true

# 1. Configure Linux network interfaces
ip addr replace 1.1.1.3/32 dev lo
ip link set dev lo up

ip addr replace 10.1.1.6/30 dev eth1
ip link set dev eth1 up

# 2. Setup VXLAN 10 and Bridge br0 (BGP-EVPN control plane learning)
ip link add dev vxlan10 type vxlan id 10 dstport 4789 local 1.1.1.3 nolearning
ip link add dev br0 type bridge
ip link set dev eth0 master br0
ip link set dev vxlan10 master br0
ip link set dev br0 up
ip link set dev vxlan10 up
ip link set dev eth0 up

# 3. Configure FRR (OSPF + iBGP EVPN)
vtysh << 'EOF'
configure terminal
!
router ospf
 ospf router-id 1.1.1.3
 network 1.1.1.3/32 area 0
 network 10.1.1.4/30 area 0
!
router bgp 1
 bgp router-id 1.1.1.3
 neighbor 1.1.1.1 remote-as 1
 neighbor 1.1.1.1 update-source lo
 !
 address-family l2vpn evpn
  neighbor 1.1.1.1 activate
  advertise-all-vni
 exit-address-family
!
end
write memory
EOF
